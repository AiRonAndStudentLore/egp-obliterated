[
 {
  "egp_id": "1741163706930x543836854317855550",
  "level": "A1",
  "super_category": "ADVERBS",
  "sub_category": "position",
  "guideword": "FORM: FREQUENCY, MID POSITION",
  "can_do_statement": "Can use frequency adverbs in the usual mid position, between the subject and the main verb.",
  "ontology": {
   "domain": "TEMPORAL_ASPECT",
   "mental_model": "MEDIAL_FREQUENCY_SLOT",
   "pedagogical_hook": "subject + always/usually/often/sometimes + verb \u2014 slot the adverb between subject and verb",
   "agency_or_distance": "speaker marks the verb's frequency medially"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:I|you|we|they|he|she|it)\\s+(?:always|usually|often|sometimes|never|hardly|rarely|seldom|frequently)\\s+(?!(?:am|is|are|was|were|will|can|could|would|should|has|have|had)\\b)[a-z]+",
   "spacy_token_pattern": [
    {
     "POS": {
      "IN": [
       "PRON",
       "NOUN",
       "PROPN"
      ]
     },
     "DEP": "nsubj"
    },
    {
     "LOWER": {
      "IN": [
       "always",
       "usually",
       "often",
       "sometimes",
       "never",
       "hardly",
       "rarely",
       "seldom",
       "frequently"
      ]
     }
    },
    {
     "POS": "VERB"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I always wake up early.",
    "She never eats meat."
   ],
   "negatives": [
    "Sometimes I go to the park.",
    "I am always tired."
   ]
  }
 },
 {
