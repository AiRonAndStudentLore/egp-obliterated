 },
 {
  "egp_id": "1741163706532x588070893184955400",
  "level": "B1",
  "super_category": "ADJECTIVES",
  "sub_category": "position",
  "guideword": "FORM: WITH PRONOUN",
  "can_do_statement": "Can use an adjective or adjective phrase after pronouns like 'something', 'nothing', 'somewhere', 'nowhere'.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "INDETERMINATE_PLACEMENT",
   "pedagogical_hook": "something / nothing + adjective \u2014 leave the referent vague and color it",
   "agency_or_distance": "speaker keeps the referent indeterminate while coloring it"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:something|nothing|everything|anything|someone|anyone|everyone|somewhere|nowhere|everywhere|anywhere)\\s+(?:very\\s+|really\\s+|quite\\s+)?(?:good|bad|new|special|important|interesting|different|strange|wrong|terrible|nice|beautiful|useful|sweet|cold|hot)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "something",
       "nothing",
       "everything",
       "anything",
       "someone",
       "anyone",
       "everyone",
       "somewhere",
       "nowhere",
       "everywhere",
       "anywhere"
      ]
     }
    },
    {
     "POS": "ADV",
     "OP": "*"
    },
    {
     "POS": "ADJ"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I want to eat something sweet.",
    "There is nothing wrong."
   ],
   "negatives": [
    "Something is on the table.",
    "I saw nothing in the room."
   ]
  }
 },
 {
  "egp_id": "1741163706536x513193449618973840",
  "level": "C1",
  "super_category": "ADJECTIVES",
  "sub_category": "superlatives",
  "guideword": "FORM/USE: WITH NOUN AND POSTMODFIER",
  "can_do_statement": "Can use a postmodifier to make the superlative stronger in the structure superlative + postmodifier + noun. ",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "POSTMODIFIED_TIER",
   "pedagogical_hook": "the + superlative + noun + that/who/which/I/you/we \u2014 annotate the top member with a clause",
   "agency_or_distance": "speaker appends a clause to sharpen the superlative target"
  },
  "detection": {
   "regex_triage": "(?i)\\bthe\\s+(?:[a-z]+est|best|worst|most\\s+[a-z]+)\\s+(?:possible|imaginable|conceivable|ever|available)\\s+[a-z]+\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "the"
    },
    {
     "LOWER": "most",
     "OP": "?"
    },
    {
     "POS": "ADJ"
    },
    {
     "LOWER": {
      "IN": [
       "possible",
       "imaginable",
       "conceivable",
       "ever",
       "available"
      ]
     }
    },
    {
     "POS": "NOUN"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "It was the worst possible outcome.",
    "He is the greatest ever player."
   ],
   "negatives": [
    "It was the worst outcome.",
    "It is a possible outcome."
   ]
  }
 },
 {
