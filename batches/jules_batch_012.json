    "guideword": "FORM/USE: 'THE MORE \u2026 THE MORE \u2026'",
    "can_do_statement": "Can use the in comparative phrases 'more', 'less', 'worse', 'better \u2026 the more', 'less', 'worse \u2026' to talk about one thing that is affected by another. \u25ba comparative clauses ",
    "ontology": {
      "domain": "TEMPORAL_ASPECT",
      "mental_model": "Correlative comparatives showing parallel increase or decrease.",
      "pedagogical_hook": "'The more... the more...' structure shows a direct relationship between two changes.",
      "agency_or_distance": "Dynamic parallel change."
    },
    "detection": {
      "regex_triage": "(?i)\\bthe\\s+(?:more|less|worse|better)\\b(?:(?:\\W|\\w)+?)\\bthe\\s+(?:more|less|worse|better)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "the"
        },
        {
          "LOWER": {
            "IN": [
              "more",
              "less",
              "worse",
              "better"
            ]
          }
        },
        {
          "OP": "?"
        },
        {
          "OP": "?"
        },
        {
          "OP": "?"
        },
        {
          "OP": "?"
        },
        {
          "OP": "?"
        },
        {
          "OP": "?"
        },
        {
          "LOWER": "the"
        },
        {
          "LOWER": {
            "IN": [
              "more",
              "less",
              "worse",
              "better"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "The more you watch, the worse you become.",
        "The better education you have, the better opportunities you get."
      ],
      "negatives": [
        "I want the more expensive one.",
        "It is getting worse and worse."
      ]
    }
  },
