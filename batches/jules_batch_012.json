    "sub_category": "articles",
    "guideword": "FORM: PREPOSITION + NO ARTICLE",
    "can_do_statement": "Can use no article before a limited range of nouns in some fixed expressions with prepositions.",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Spatial and conceptual relationships formalized without specific entity bounding.",
      "pedagogical_hook": "Common prepositional phrases lack articles because they treat locations or times as concepts.",
      "agency_or_distance": "Conceptual distance over physical bounds."
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:at|by|to|in|on)\\s+(?:home|college|school|work|bed|car|bus|train)\\b",
      "spacy_token_pattern": [
        {
          "LEMMA": {
            "IN": [
              "at",
              "by",
              "to",
              "in",
              "on"
            ]
          }
        },
        {
          "LEMMA": {
            "IN": [
              "home",
              "college",
              "school",
              "work",
              "bed",
              "car",
              "bus",
              "train"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I am at home right now.",
        "We usually travel by bus."
      ],
      "negatives": [
        "I am at the home of my friend.",
        "Look at that car."
      ]
    }
  },
