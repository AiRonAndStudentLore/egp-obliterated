  "detection": {
   "regex_triage": "(?i)\\bmight(?:\\s+[a-z]+ly)?\\s+not(?:\\s+[a-z]+ly)?\\s+have(?:\\s+[a-z]+ly)?\\s+[a-z]+(?:ed|en|t|n|d)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "might"
    },
    {
     "POS": "ADV",
     "OP": "?"
