 {
  "egp_id": "1741163710843x377860994738539200",
  "level": "B1",
  "super_category": "MODALITY",
  "sub_category": "might",
  "lexical_range": "N/A",
  "guideword": "USE: FOCUS",
  "can_do_statement": "Can use 'might' in phrases, such as 'as you might know', 'have already heard', to focus the reader on shared knowledge.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "Focusing reader on shared knowledge",
   "pedagogical_hook": "Shared knowledge focus",
   "agency_or_distance": "agency"
  },
  "detection": {
   "regex_triage": "(?i)\\bas\\s+(?:you|we)\\s+might(?:\\s+[a-z]+ly)?\\s+(?:have(?:\\s+[a-z]+ly)?\\s+)?(?:know|hear|guess|see|notice|expect)[a-z]*\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "as"
    },
    {
     "LOWER": {
      "IN": [
       "you",
       "we"
      ]
     }
    },
    {
     "LOWER": "might"
    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "LOWER": "have",
     "OP": "?"
    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "LEMMA": {
      "IN": [
       "know",
       "hear",
       "guess",
       "see",
       "notice",
       "expect"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "As you might know, we are moving.",
    "As you might have heard, she resigned."
   ],
   "negatives": [
    "You might know the answer to this.",
    "They might have heard the news by now."
   ]
  }
 },
