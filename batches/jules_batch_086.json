    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "LOWER": "have"
    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "POS": {
      "IN": [
       "VERB",
       "AUX"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "She might not have realised the time.",
    "They might not have seen it."
