  "guideword": "FORM: 'THIS' WITH UNCOUNTABLE NOUNS",
  "can_do_statement": "Can use 'this' with uncountable nouns. \u25ba noun phrases \u25ba  pronouns: demonstrative",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "Identification of specific, singular, or uncountable entities in the immediate context.",
   "pedagogical_hook": "Pointing to 'this' specific item or substance.",
   "agency_or_distance": "Proximal"
  },
  "detection": {
   "regex_triage": "\\bthis\\s+(?:information|advice|weather|news|furniture|equipment|luggage|baggage|homework|traffic|money|knowledge|music|water|milk|coffee|tea|bread|rice|sugar|cheese|meat|fun|progress|research|evidence|luck)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "this",
     "DEP": "det"
    },
    {
     "OP": "*",
     "POS": {
      "IN": [
       "ADJ",
       "NUM"
      ]
     }
    },
    {
     "LOWER": {
      "IN": [
       "information",
       "advice",
       "weather",
       "news",
       "furniture",
       "equipment",
       "luggage",
       "baggage",
       "homework",
       "traffic",
       "money",
       "knowledge",
       "music",
       "water",
       "milk",
       "coffee",
       "tea",
       "bread",
       "rice",
       "sugar",
       "cheese",
       "meat",
       "fun",
       "progress",
       "research",
       "evidence",
       "luck"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I need this information right now.",
    "This luggage is very heavy."
   ],
   "negatives": [
    "This topic is interesting.",
    "This block is very hard."
   ]
  }
 },
 {
