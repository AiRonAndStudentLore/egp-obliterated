 },
 {
  "egp_id": "1741163706317x616093618641182500",
  "level": "B1",
  "super_category": "ADJECTIVES",
  "sub_category": "combining",
  "guideword": "FORM: COMBINING COMPARATIVE ADJECTIVES WITH 'AND'",
  "can_do_statement": "Can use 'and' to join a limited range of comparative adjectives.\u25ba adjectives: comparatives",
  "ontology": {
   "agency_or_distance": "comparative pairing",
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "two scales raised together",
   "pedagogical_hook": "more of both"
  },
  "detection": {
   "regex_triage": "\\b([a-z]+er|worse|better)\\s+and\\s+(?!\\1\\b)(?:[a-z]+er|worse|better)\\b",
   "spacy_token_pattern": [
    {
     "TAG": {
      "IN": [
       "JJR",
       "JJ"
      ]
     },
     "LOWER": {
      "REGEX": "^(better|worse|[a-z]+er)$"
     }
    },
    {
     "LOWER": "and"
    },
    {
     "TAG": {
      "IN": [
       "JJR",
       "JJ"
      ]
     },
     "LOWER": {
      "REGEX": "^(better|worse|[a-z]+er)$"
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Computers are getting cheaper and better.",
    "The weather is warmer and nicer today."
   ],
   "negatives": [
    "It is cheaper, and the quality is better.",
    "The weather is hot and humid."
   ]
  }
 },
 {
  "egp_id": "1741163706327x526332173403099460",
  "level": "B1",
  "super_category": "ADJECTIVES",
  "sub_category": "modifying",
  "guideword": "FORM: WITH 'ENOUGH' ",
  "can_do_statement": "Can use 'enough' to modify adjectives. ",
  "ontology": {
   "agency_or_distance": "sufficient degree",
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "the attribute reaches the threshold",
   "pedagogical_hook": "past the line"
  },
  "detection": {
   "regex_triage": "(?:is|are|was|were|am|be)\\s+(?:not\\s+)?(big|good|old|young|strong|tall|warm|safe|clear|hard|easy)\\s+enough(?:\\s+(?:to|for|because)|\\s*[.,!?]|$)",
   "spacy_token_pattern": [
    {
     "POS": "ADJ"
    },
    {
     "LOWER": "enough",
     "DEP": "advmod"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "The house is big enough for us.",
    "My coffee is not strong enough."
   ],
   "negatives": [
    "Enough has been said about it.",
    "We have enough big boxes."
   ]
  }
 },
 {
