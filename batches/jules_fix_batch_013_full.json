  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: CERTAINTY",
  "can_do_statement": "Can use a wide range of adverbs to indicate degrees of certainty. ",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "WIDE_CERTAINTY_GRADIENT",
   "pedagogical_hook": "undoubtedly / undeniably / certainly / definitely / surely / presumably \u2014 high end of the certainty dial",
   "agency_or_distance": "speaker marks the proposition as settled"
  },
  "detection": {
   "regex_triage": "(?:\\b(?:is|are|was|were|will|can|could|would|should|has|have|had|do|does|did)\\s+)?\\b(?:undoubtedly|undeniably|certainly|definitely|surely|presumably|indubitably|unquestionably)\\s+(?!not\\b)(?:be|have|do|[a-z]{2,})\\b",
   "spacy_token_pattern": [
    {
     "POS": {
      "IN": [
       "AUX",
       "VERB",
       "PRON",
       "NOUN",
       "PROPN"
      ]
     }
    },
    {
     "LOWER": {
      "IN": [
       "undoubtedly",
       "undeniably",
       "certainly",
       "definitely",
       "surely",
       "presumably",
       "indubitably",
       "unquestionably"
      ]
     }
    },
    {
     "POS": {
      "IN": [
       "VERB",
       "ADJ",
       "ADV",
       "PART",
       "AUX"
      ]
     },
     "LOWER": {
      "NOT_IN": [
       "not"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I will undoubtedly finish the project.",
    "She is undeniably talented."
   ],
   "negatives": [
    "Well, but definitely I would rather not know when.",
    "Next guy this one definitely not."
   ]
  }
 },
 {
  "egp_id": "1741163706325x499920484410304700",
  "level": "C2",
  "super_category": "ADJECTIVES",
  "sub_category": "comparatives",
  "guideword": "FORM/USE: WITH 'NO' OR 'NOT ANY' ",
  "can_do_statement": "Can use 'no' / 'not any' with comparative adjectives to limit the scale of comparison. \u25ba comparative clauses",
  "ontology": {
   "agency_or_distance": "scale ceiling",
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "no caps the scale at zero difference",
   "pedagogical_hook": "deny the gap entirely"
  },
  "detection": {
   "regex_triage": "\\b(?:no|not\\s+any)\\s+(?:better|worse|more|less|further|farther|[a-z]{2,}er)\\b",
   "spacy_token_pattern": [
