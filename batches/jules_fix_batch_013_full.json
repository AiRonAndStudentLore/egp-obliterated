    "Not older, it's like 45."
   ]
  }
 },
 {
  "egp_id": "1741163706322x402656530651300600",
  "level": "C2",
  "super_category": "ADJECTIVES",
  "sub_category": "combining",
  "guideword": "FORM: COMBINING MULTIPLE ADJECTIVES",
