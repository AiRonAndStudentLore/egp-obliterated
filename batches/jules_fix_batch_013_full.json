     "LOWER": "not",
     "OP": "?"
    },
    {
     "LOWER": {
      "IN": [
       "no",
       "any"
      ]
     }
    },
    {
     "TAG": {
      "IN": [
       "JJR",
       "RBR"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "It is no better than before.",
