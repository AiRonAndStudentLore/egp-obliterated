[
  {
    "egp_id": "1741163715816x805574954101757600",
    "level": "C1",
    "super_category": "DISCOURSE MARKERS",
    "sub_category": "discourse markers in writing",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: TEXTUAL REFERENCE",
    "can_do_statement": "Can use a range of phrases as discourse markers to point to other parts of a text. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Textual space mapping",
      "pedagogical_hook": "Navigating references within a document",
      "agency_or_distance": "Spatial distance within the text"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:as|see|is)\\s+(?:mentioned|shown|stated|discussed|explained)\\s+(?:above|below|earlier|previously)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "as",
              "is"
            ]
          }
        },
        {
          "LEMMA": {
            "IN": [
              "mention",
              "show",
              "state",
              "discuss",
              "explain"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "above",
              "below",
              "earlier",
              "previously"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "As mentioned earlier, we have already shipped the order.",
        "The results are completely valid, as shown above."
      ],
      "negatives": [
        "He mentioned earlier that he would be late.",
        "The painting above the fireplace is beautiful."
      ]
    }
  },
  {
    "egp_id": "1741163715816x910085760581765400",
    "level": "B2",
    "super_category": "DISCOURSE MARKERS",
    "sub_category": "discourse markers in writing",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: ORGANISING, OPENINGS AND CLOSINGS, FORMAL",
    "can_do_statement": "Can use a range of phrases as discourse markers to open and close texts and point to conclusions, often in formal contexts. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Discourse structuring",
      "pedagogical_hook": "Formal sectioning of arguments",
      "agency_or_distance": "Structuring logical progression"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:in\\s+conclusion|in\\s+summary|to\\s+sum\\s+up)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "in"
        },
        {
          "LOWER": {
            "IN": [
              "conclusion",
              "summary"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "In conclusion, the experiment was a complete success.",
        "In summary, we need to focus on cost reduction."
      ],
      "negatives": [
        "We arrived at the same conclusion yesterday.",
        "He gave a quick summary of the plot."
      ]
    }
  },
  {
    "egp_id": "1741163715820x150522391030215800",
    "level": "B1",
    "super_category": "FOCUS",
    "sub_category": "focus",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: FRONTING, ADVERBS",
    "can_do_statement": "Can use adverbs in the front position for focus.",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Information structuring via fronting",
      "pedagogical_hook": "Putting the spotlight on the adverb",
      "agency_or_distance": "Emphatic positioning"
    },
    "detection": {
      "regex_triage": "(?i)^(?:Here|Quickly|Suddenly|Outside|Slowly|Unfortunately)\\b\\s*,?\\s+(?:I|he|she|it|they|we|the|a)\\b",
      "spacy_token_pattern": [
        {
          "IS_SENT_START": true,
          "LOWER": {
            "IN": [
              "here",
              "quickly",
              "suddenly",
              "outside",
              "slowly",
              "unfortunately"
            ]
          }
        },
        {
          "IS_PUNCT": true,
          "OP": "?"
        },
        {
          "LOWER": {
            "IN": [
              "i",
              "he",
              "she",
              "it",
              "they",
              "we",
              "the",
              "a"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Suddenly, the door swung wide open.",
        "Quickly I grabbed my coat and left."
      ],
      "negatives": [
        "The door suddenly swung wide open.",
        "I quickly grabbed my coat and left."
      ]
    }
  },
  {
    "egp_id": "1741163715820x418754553525479940",
    "level": "B1",
    "super_category": "FOCUS",
    "sub_category": "focus",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: 'IT' + 'BE' ADJECTIVE + 'THAT' CLAUSE",
    "can_do_statement": "Can use 'it' + 'be' + adjective + 'that-'clause for focus. ",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Evaluative extraposition",
      "pedagogical_hook": "Stating an opinion objectively",
      "agency_or_distance": "Distanced evaluation"
    },
    "detection": {
      "regex_triage": "(?i)\\bit\\s*(?:is|was|'s)\\s+(?:really\\s+|very\\s+)?(?:great|true|important|sad|good|nice|clear)\\s+that\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "it"
        },
        {
          "LEMMA": "be"
        },
        {
          "LOWER": {
            "IN": [
              "really",
              "very",
              "extremely"
            ]
          },
          "OP": "?"
        },
        {
          "POS": "ADJ"
        },
        {
          "LOWER": "that"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "It's great that you found a new apartment.",
        "It is important that everyone arrives on time."
      ],
      "negatives": [
        "I think that it is a great idea.",
        "That book is really great."
      ]
    }
  },
  {
