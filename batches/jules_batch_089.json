        {
          "LOWER": {
            "NOT_IN": [
              "i",
              "we",
              "what",
              "where",
              "how",
              "when",
              "why"
            ]
          }
        },
        {
          "LOWER": "shall"
        },
        {
          "LEMMA": {
            "IN": [
              "be",
              "have",
              "provide",
              "pay",
              "fulfil",
              "fulfill",
              "do"
            ]
          }
        }
      ]
    },
    "unit_tests": {
