    "can_do_statement": "Can use 'shall' in the main clause after an 'if-' clause  \u25ba conditionals",
    "example_raw": "Nowadays people live longer than they did in the past, which is very nice and pleasant, but we must be careful because if things get out of hand, \u2026 we shall be doomed to live in complete chaos. (Portuguese, C2 MASTERY, Pass, 1993)\n\nI have to inform you that if we do not receive a reply this time we shall take the matter to court. (Poland; C2 MASTERY; 1993; Polish; Pass)",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Consequence dependent on a condition.",
      "pedagogical_hook": "'If ... shall ...' for conditional outcomes.",
      "agency_or_distance": "Conditional future consequence."
    },
    "detection": {
      "regex_triage": "(?i)\\bif\\b.*\\bshall\\b|\\bshall\\b.*\\bif\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "if"
        },
        {
          "OP": "*"
        },
        {
          "LOWER": "shall"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "If it rains, we shall stay inside.",
        "If we fail, they shall win."
      ],
      "negatives": [
        "We shall go to the store.",
        "If it rains, we will stay."
      ]
    }
  },
