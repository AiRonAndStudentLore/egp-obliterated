[
 {
  "egp_id": "1741163713875x793481865058558700",
  "level": "B1",
  "super_category": "PRONOUNS",
  "sub_category": "subject/ object",
  "lexical_range": "1",
  "guideword": "FORM: (SUBJECT) USING 'IT' TO INTRODUCE",
  "can_do_statement": "Can use dummy 'it' as a subject to introduce something the speaker or writer is going to refer to.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "Dummy 'it' to set up a situation or refer forward",
   "pedagogical_hook": "Using 'it' to introduce a topic",
   "agency_or_distance": "distance"
  },
  "detection": {
   "regex_triage": "(?i)\\bit(?:'s|\\s+(?:is|was))\\s+(?:[a-z]+\\s+){0,3}(?:to|that)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "it"
    },
    {
     "LEMMA": "be"
    },
    {
     "OP": "*"
    },
    {
     "LOWER": {
      "IN": [
       "to",
       "that"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "It is best to spend your time in the countryside.",
    "It's normal that your parents want you to go with them."
   ],
   "negatives": [
    "It is my favorite book.",
    "It was sitting on the table."
   ]
  }
 },
