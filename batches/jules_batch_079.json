[
  {
    "egp_id": "1741163711538x884306688947976100",
    "level": "B1",
    "super_category": "MODALITY",
    "sub_category": "adverbs",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: MODAL VERB + MODAL ADVERB, HEDGING OR EMPHASIS",
    "can_do_statement": "Can use modal verb + modal adverb to modify an assertion, either through hedging or emphasis.",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Speaker evaluates probability or necessity using a modal verb combined with a modifying adverb.",
      "pedagogical_hook": "We use adverbs like 'probably', 'certainly', or 'surely' after modal verbs to emphasize or hedge the meaning.",
      "agency_or_distance": "INTERNAL"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:can|could|will|would|shall|should|may|might|must)(?:'t|nt| not)?\\s+(?:surely|certainly|probably|definitely|possibly|really)\\b",
      "spacy_token_pattern": [
        {
          "LEMMA": {
            "IN": [
              "can",
              "could",
              "will",
              "would",
              "shall",
              "should",
              "may",
              "might",
              "must"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "not",
              "n't"
            ]
          },
          "OP": "?"
        },
        {
          "LOWER": {
            "IN": [
              "surely",
              "certainly",
              "probably",
              "definitely",
              "possibly",
              "really"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "You should probably bring your coat.",
        "He could definitely win the race."
      ],
      "negatives": [
        "He probably should bring his coat.",
        "You definitely have a point."
      ]
    }
  },
