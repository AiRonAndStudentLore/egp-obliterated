   "spacy_token_pattern": [
    {
     "LOWER": "let"
    },
    {
     "LOWER": "'s"
    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "POS": "VERB",
     "TAG": "VB",
     "LEMMA": {
      "NOT_IN": [
       "see",
       "say",
       "talk",
       "start",
       "take"
      ]
     }
    }
   ]
  },
  "unit_tests": {
