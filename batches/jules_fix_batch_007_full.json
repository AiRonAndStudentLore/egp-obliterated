[
 {
  "egp_id": "1741163706724x172374615365169500",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: SEQUENCING",
  "can_do_statement": "Can use a limited range of adverbs and adverb phrases ('first', 'then', 'after that') to order segments of discourse.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "DISCOURSE_LINEARISATION",
   "pedagogical_hook": "first / then / after that \u2014 map the events onto a timeline",
   "agency_or_distance": "speaker arranges discourse events in chronological order"
  },
  "detection": {
   "regex_triage": "(?i)^(?:(?:and|but|so|well|because)\\s+)?(?:first|then|after\\s+that)[\\s,]+(?:i|you|he|she|it|we|they|there)\\b",
   "spacy_token_pattern": [
    {
     "IS_SENT_START": true,
     "LOWER": {
      "IN": [
       "and",
       "but",
       "so",
       "well",
       "because"
      ]
     },
     "OP": "?"
    },
    {
     "LOWER": {
      "IN": [
       "first",
       "then",
       "after"
      ]
     }
    },
    {
     "LOWER": "that",
     "OP": "?"
    },
    {
     "IS_PUNCT": true,
     "OP": "?"
    },
    {
     "LOWER": {
      "IN": [
       "i",
       "you",
       "he",
       "she",
       "it",
       "we",
       "they",
       "there"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "First, I went to the mall.",
    "And then, she started crying."
   ],
   "negatives": [
    "I was the first person there.",
    "First thing I do is sleep."
   ]
  }
 },
 {
  "egp_id": "1741163706534x910876285707473500",
  "level": "A2",
  "super_category": "ADJECTIVES",
  "sub_category": "superlatives",
  "guideword": "FORM: WITH '-EST' ",
  "can_do_statement": "Can form superlative adjectives by adding the suffix '-est', to adjectives of one syllable.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "a one-syllable adjective bolts -est on the end to claim top rank",
   "pedagogical_hook": "old, older, the OLD - est",
   "agency_or_distance": "speaker asserts an absolute peak on a scale"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:the|my|your|his|her|our|their)\\s+(?!(?:test|rest|west|quest|chest|least|lest|forest|interest|contest|protest|request|digest|modest|honest|suggest|invest|divest|manifest|attest)\\b|[a-z]*iest\\b)([a-z]+est)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "the",
       "my",
       "your",
       "his",
       "her",
       "our",
       "their"
      ]
     }
    },
    {
     "LOWER": {
      "IN": [
       "oldest",
       "cheapest",
       "fastest",
       "tallest",
       "coolest",
       "strongest",
       "highest",
       "lowest",
       "newest",
       "richest",
       "poorest",
       "smartest",
       "plainest",
       "barest",
       "clearest",
       "hottest",
       "biggest"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "It is the biggest company here.",
    "He was my fastest runner."
   ],
   "negatives": [
    "It is the most biggest city.",
    "It is one of the 3 biggest cities."
   ]
  }
 },
 {
  "egp_id": "1741163708331x891503713311455000",
  "level": "A2",
  "super_category": "CLAUSES",
  "sub_category": "imperatives",
  "guideword": "FORM/USE: NEGATIVE ",
  "can_do_statement": "Can form a negative imperative with the auxiliary verb 'do' + 'n't' + base form of a main verb, to give advice, instructions or orders. ",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "",
   "pedagogical_hook": "",
   "agency_or_distance": ""
  },
  "detection": {
   "regex_triage": "(?i)^(?:(?:Please|[A-Z][a-z]+[,!])\\s+)?\\bDon't\\s+(?!(?:worry|panic|forget|hesitate|mind|freak|bother)\\b)(?:[a-z]+ly\\s+)?([a-z]+)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "do",
     "IS_SENT_START": true
    },
    {
     "LOWER": "n't"
    },
    {
     "POS": "ADV",
     "OP": "?"
    },
    {
     "POS": "VERB",
     "TAG": "VB",
     "LEMMA": {
      "NOT_IN": [
       "worry",
       "panic",
       "forget",
       "hesitate",
       "mind",
       "freak",
       "bother"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Don't touch that button.",
    "Don't go there alone."
   ],
   "negatives": [
    "Don't worry about it.",
    "Don't mind me."
   ]
  }
 },
 {
  "egp_id": "1741163708331x357890058176217500",
  "level": "A2",
  "super_category": "CLAUSES",
  "sub_category": "imperatives",
  "guideword": "USE: EMPHASISING AN INSTRUCTION ",
  "can_do_statement": "Can use negative imperative after an instruction, for emphasis.",
  "ontology": {
   "domain": "DEONTIC_FORCE",
   "mental_model": "DIRECT_ACTION_CONTROL",
   "pedagogical_hook": "Second Nail \u2014 driving the warning home after the instruction has already landed.",
   "agency_or_distance": "EMPHATIC_REINFORCEMENT"
  },
  "detection": {
   "regex_triage": "(?i)^(?!no\\b|don't\\b|yes\\b|yeah\\b|oh\\b).+[.,!]\\s*\\bdon't\\s+(?:forget|be\\s+late|worry|panic|hesitate|give\\s+up|miss\\s+it|tell\\s+anyone)\\b",
   "spacy_token_pattern": [
    {
     "IS_SENT_START": true,
     "POS": "VERB",
     "TAG": "VB",
     "LEMMA": {
      "NOT_IN": [
       "do"
      ]
     }
    },
    {
     "OP": "*"
    },
    {
     "IS_PUNCT": true
    },
    {
     "LOWER": "do"
    },
    {
     "LOWER": "n't"
    },
    {
     "LOWER": {
      "IN": [
       "forget",
       "be",
       "worry",
       "panic",
       "hesitate",
       "give",
       "miss",
       "tell"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Call me, don't forget.",
    "Keep trying, don't give up."
   ],
   "negatives": [
    "No, don't worry.",
    "Don't give up, don't give up."
   ]
  }
 },
 {
  "egp_id": "1741163706722x446923325299920960",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: LINKING",
  "can_do_statement": "Can use a limited range of adverbs ('also', 'so', 'however') to show a relationship between two clauses or sentences. ",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "DISCOURSE_COUPLING",
   "pedagogical_hook": "also / so / however \u2014 wire two ideas into one discourse",
   "agency_or_distance": "speaker binds clauses into a relationship of addition, result, or contrast"
  },
  "detection": {
   "regex_triage": "(?i)\\b[a-z]+\\b.*?[.,!]\\s+(?:and\\s+)?(also|so|however)\\s+(?:i|you|he|she|it|we|they|there|the|[a-z]+)\\b",
   "spacy_token_pattern": [
    {
     "IS_PUNCT": true
    },
    {
     "LOWER": "and",
     "OP": "?"
    },
    {
     "LOWER": {
      "IN": [
       "also",
       "so",
       "however"
      ]
     }
    },
    {
     "POS": {
      "IN": [
       "PRON",
       "DET",
       "NOUN",
       "PROPN"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I was tired, so I went to bed.",
    "He likes cats, however John is allergic."
   ],
   "negatives": [
    "He is so strong.",
    "So I went to the store."
   ]
  }
 },
 {
  "egp_id": "1741163708331x843997098925344500",
  "level": "A2",
  "super_category": "CLAUSES",
  "sub_category": "imperatives",
