   "regex_triage": "(?i)^(?:(?:Please|[A-Z][a-z]+[,!])\\s+)?\\b(Take|Walk|Go|Turn|Cross)\\b\\s+(?:straight|left|right|past|down|up|the\\s+(?:first|second|street|road|corner))\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "take",
       "walk",
       "go",
       "turn",
       "cross"
      ]
     },
     "IS_SENT_START": true
    },
    {
     "LOWER": {
      "IN": [
       "straight",
       "left",
       "right",
       "past",
       "down",
       "up",
       "the"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Turn left at the corner.",
