   ]
  }
 },
 {
  "egp_id": "1741163706939x328491474615097540",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "position",
  "guideword": "FORM: DEGREE, END POSITION",
  "can_do_statement": "Can use degree adverbs in end position.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "FINAL_DEGREE_AMPLIFICATION",
   "pedagogical_hook": "verb + a lot / so much / very much \u2014 push the degree to the clause tail",
   "agency_or_distance": "speaker amplifies degree at the end of the clause"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:a\\s+lot|a\\s+little|so\\s+much|quite\\s+a\\s+bit|too\\s+much|very\\s+much|enormously)\\s*(?:[.,?!:;]|\\s*$)",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "lot",
       "little",
       "much",
       "bit",
       "enormously"
      ]
     }
    },
    {
     "LOWER": {
      "NOT_IN": [
       "of",
       "in",
       "to"
      ]
     },
     "POS": {
      "NOT_IN": [
       "NOUN",
       "ADJ"
      ]
     },
     "OP": "?"
    },
    {
     "IS_PUNCT": true
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I like it a lot.",
    "He helped me so much!"
   ],
   "negatives": [
    "I have a lot of time.",
    "She has so much money."
   ]
  }
 },
 {
