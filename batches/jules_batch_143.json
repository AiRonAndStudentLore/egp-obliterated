            "IN": [
              "n't",
              "not",
              "n\u2019t"
            ]
          }
        },
        {
          "POS": {
            "IN": [
              "PRON",
              "NOUN",
              "PROPN",
              "DET"
            ]
          }
        },
        {
          "POS": {
            "IN": [
              "PRON",
              "NOUN",
              "PROPN",
              "DET"
            ]
          },
          "OP": "?"
        },
        {
          "LOWER": {
            "NOT_IN": [
              "n't",
              "not",
              "n\u2019t",
              ".",
              "?",
              "!"
            ]
          },
          "OP": "?"
        },
        {
          "LEMMA": {
            "IN": [
              "think",
              "sound",
              "like",
              "agree",
              "believe",
              "feel",
              "look",
              "seem",
              "suppose"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Doesn't it really sound like a good idea?",
        "Don't you think we should go now?"
      ],
      "negatives": [
        "I don't think it sounds good.",
        "You do not like it at all."
      ]
    }
