      "pedagogical_hook": "Checking opinions using negative questions.",
      "agency_or_distance": "Interpersonal involvement"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:do|does|is|are)(?:n['\u2019]?t|\\s+not)(?:\\s+[a-z]+ly)?\\s+(?:[a-z]+\\s+){1,3}(?:think|sound|like|agree|believe|feel|look|seem|suppose)\\b",
