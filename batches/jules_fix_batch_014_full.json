   ]
  }
 },
 {
  "egp_id": "1741163706931x922201162401665300",
  "level": "A1",
  "super_category": "ADVERBS",
  "sub_category": "position",
  "guideword": "FORM: TIME, END POSITION",
  "can_do_statement": "Can use time adverbs in the usual end position.",
  "ontology": {
   "domain": "TEMPORAL_ASPECT",
   "mental_model": "FINAL_TIME_ANCHOR",
   "pedagogical_hook": "verb + yesterday/today/tomorrow/soon/now/just/already \u2014 anchor the time at the clause tail",
   "agency_or_distance": "speaker places the time at the end of the clause"
  },
  "detection": {
   "regex_triage": "(?i)\\b[a-z]+\\s+(?:yesterday|today|tomorrow|soon|now|tonight|then)\\s*[.?!]",
   "spacy_token_pattern": [
    {
     "IS_ALPHA": true
    },
    {
     "LOWER": {
      "IN": [
       "yesterday",
       "today",
       "tomorrow",
       "soon",
       "now",
       "tonight",
       "then"
      ]
     }
    },
    {
     "TEXT": {
      "IN": [
       ".",
       "!",
       "?"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I am going to the store tomorrow.",
    "We should really leave now!"
   ],
   "negatives": [
    "Tomorrow I will go to the store.",
    "Today is a very good day."
   ]
  }
 },
 {
