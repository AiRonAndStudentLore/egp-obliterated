[
 {
  "egp_id": "1741163706532x162687205151185180",
  "level": "A1",
  "super_category": "ADJECTIVES",
  "sub_category": "superlatives",
  "guideword": "FORM: 'MY BEST FRIEND'",
  "can_do_statement": "Can use the irregular superlative adjective 'best' in the phrase 'my best friend'.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "one person crowned as top member of a set by the speaker",
   "pedagogical_hook": "crown your number-one person",
   "agency_or_distance": "possessive anchors the ranking to the speaker's own world"
  },
  "detection": {
   "regex_triage": "(?i)\\bmy\\s+best\\s+friends?\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "my"
    },
    {
     "LOWER": "best"
    },
    {
     "LOWER": {
      "IN": [
       "friend",
       "friends"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "She is my best friend in the whole world.",
    "I love hanging out with my best friends."
