 {
  "egp_id": "1741163706722x170602944998903700",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: DEGREE WITH VERBS",
  "can_do_statement": "Can use a limited range of adverbs and adverb phrases ('so much', 'a lot') with verbs to indicate degree or intensity. \u25ba determiners",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "INTENSITY_VOCALISATION",
   "pedagogical_hook": "so much / a lot \u2014 amplify the verb to maximum volume",
   "agency_or_distance": "speaker cranks the speaker-level of feeling or action"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:so\\s+much|a\\s+lot)\\b(?!\\s+(?:of\\b|[a-z]+\\b))|\\b(?:so\\s+much|a\\s+lot)\\b(?=\\s+(?:because|when|if|and|but)\\b)",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "so",
       "a"
      ]
     }
    },
    {
     "LOWER": {
      "IN": [
       "much",
       "lot"
      ]
     }
    },
    {
     "LOWER": {
      "NOT_IN": [
       "of"
      ]
     },
     "POS": {
      "NOT_IN": [
       "NOUN",
       "PROPN",
       "ADJ",
       "DET"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I like it a lot.",
    "She worries so much."
   ],
   "negatives": [
    "I have a lot of time.",
    "We spent so much money."
   ]
  }
 },
 {
  "egp_id": "1741163706723x300249420014393500",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: FOCUS",
  "can_do_statement": "Can use a limited range of adverbs ('only', 'just') to focus on or point to something.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "FOCUS_NARROWING",
   "pedagogical_hook": "only / just \u2014 spotlight a single element, dimming the rest",
   "agency_or_distance": "speaker isolates one referent from a presumed larger set"
  },
  "detection": {
   "regex_triage": "(?i)(?<!\\bthe\\s)(?<!\\ban\\s)(?<!\\ba\\s)(?<!\\bmy\\s)(?<!\\byour\\s)(?<!\\bhis\\s)(?<!\\bher\\s)(?<!\\bour\\s)(?<!\\btheir\\s)(?<!\\bits\\s)\\b(?:only|just)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "only",
       "just"
      ]
     },
     "POS": "ADV"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I only want to sleep.",
    "It is just a scratch."
   ],
   "negatives": [
    "He is the only person here.",
    "That is a just cause."
   ]
  }
 },
 {
  "egp_id": "1741163706722x642517242671444100",
  "level": "A2",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
