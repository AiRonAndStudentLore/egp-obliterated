[
  {
    "egp_id": "1741163708567x363468807312569340",
    "level": "B1",
    "super_category": "CLAUSES",
    "sub_category": "subordinated",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: REASON",
    "can_do_statement": "Can use a finite subordinate clause with conjunctions to introduce reasons, after a main clause. ",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Establishing a causal relationship between events",
      "pedagogical_hook": "Giving reasons with 'as' or 'since'",
      "agency_or_distance": "agency"
    },
    "detection": {
      "regex_triage": "(?i)(?:^|[,;]\\s*|\\s)\\b(?:as|since|because)\\s+(?:[a-z]+(?:'s|'re|'m|'ve|'ll|'d)?\\s+){0,3}(?:am|is|are|was|were|have|has|had|do|does|did|will|would|can|could|shall|should|may|might|must|[a-z]+s|[a-z]+ed|be)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "as",
              "since",
              "because"
            ]
          },
          "DEP": "mark"
        },
        {
          "DEP": {
            "IN": [
              "nsubj",
              "nsubjpass",
              "expl"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I prefer to stay home, as I have got another appointment.",
        "We will have to cancel the trip since it is raining heavily."
      ],
      "negatives": [
        "I have been living here since 2010.",
        "She works as a manager in the new company."
      ]
    }
  },
  {
