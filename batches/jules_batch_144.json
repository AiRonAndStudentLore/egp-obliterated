[
  {
    "egp_id": "1741163714100x832020859880195100",
    "level": "B1     ",
    "super_category": "PRONOUNS",
    "sub_category": "demonstratives",
    "lexical_range": "N/A",
    "guideword": "FORM: MODIFYING",
    "can_do_statement": "Can use quantifying determiners + 'of' with demonstrative pronouns  \u25ba determiners: demonstrative",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Selection from a specific spatial or conceptual set",
      "pedagogical_hook": "quantifier + of + demonstrative",
      "agency_or_distance": "DISTANCE"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:one|all|some|many|both|few|several|lot|lots|any|none|each|two|three|most|much)\\s+of\\s+(?:this|that|these|those)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "one",
              "all",
              "some",
              "many",
              "both",
              "few",
              "several",
              "lot",
              "lots",
              "any",
              "none",
              "each",
              "two",
              "three",
              "most",
              "much"
            ]
          }
        },
        {
          "LOWER": "of"
        },
        {
          "LOWER": {
            "IN": [
              "this",
              "that",
              "these",
              "those"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I think you should choose one of these.",
        "We really need to see all of that."
      ],
      "negatives": [
        "One of the best things to do is relax.",
        "Some of them are really quite interesting."
      ]
    }
  },
  {
