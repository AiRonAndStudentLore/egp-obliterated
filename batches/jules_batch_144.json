    "level": "C1",
    "super_category": "PRONOUNS",
    "sub_category": "demonstratives",
    "lexical_range": "N/A",
    "guideword": "FORM: 'THAT OF', 'THOSE OF'",
    "can_do_statement": "Can use 'that of' and 'those of' as a possessive form, in formal and professional contexts. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Formal comparison avoiding repetition of the head noun",
      "pedagogical_hook": "that of / those of",
      "agency_or_distance": "DISTANCE"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:that|those)\\s+of\\b(?!\\s+(?:us|them|you|mine|ours|yours|theirs|him|her)\\b)",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "that",
              "those"
            ]
          }
        },
        {
          "LOWER": "of"
        },
        {
          "LOWER": {
            "NOT_IN": [
              "us",
              "them",
              "you",
              "mine",
              "ours",
              "yours",
              "theirs",
              "him",
              "her",
              "it",
              "me"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Their approach is quite different from that of their competitors.",
        "The opinions expressed do not reflect those of the general population."
      ],
      "negatives": [
        "I am not sure of that.",
        "Those of us who were there know the truth."
      ]
    }
  },
  {
    "egp_id": "1741163714101x483581657596987140",
    "level": "B2",
    "super_category": "PRONOUNS",
    "sub_category": "demonstratives",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: 'THOSE', SUBSTITUTION ",
    "can_do_statement": "Can use 'those' as a substitute, followed by a relative clause or '-ed' or '-ing'. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Defining a subgroup using a demonstrative pronoun with a modifier",
      "pedagogical_hook": "those + relative clause/participle",
      "agency_or_distance": "DISTANCE"
    },
    "detection": {
      "regex_triage": "(?i)\\bthose\\s+(?:who|which|that|whom|whose|[a-z]+ing|[a-z]+ed|built|left|kept|made|found|chosen|surveyed|attending)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "those"
        },
        {
          "LOWER": {
            "REGEX": "^(who|which|that|whom|whose|.*ing|.*ed|built|left|kept|made|found|chosen|surveyed|attending)$"
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "It is a good idea for those who are interested in sports.",
        "All those attending are requested to be on time."
      ],
      "negatives": [
        "Those people who live there are very happy.",
        "I want to read those books that you mentioned."
      ]
    }
  },
