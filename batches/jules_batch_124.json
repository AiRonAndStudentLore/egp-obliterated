        {
          "LOWER": "do",
          "TAG": "VB"
        },
        {
          "LOWER": {
            "IN": [
              "not",
              "n't"
            ]
          }
        },
        {
          "POS": {
            "IN": [
              "VERB",
              "AUX"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Don't forget your electric guitar.",
        "Please do not be late for the meeting."
      ],
      "negatives": [
        "I don't forget my friends.",
        "They do not want to be late."
      ]
    }
  },
  {
