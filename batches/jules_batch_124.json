  },
  {
    "egp_id": "1741163716068x445742738976088800",
    "level": "A2",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
    "guideword": "FORM: 'DO', IMPERATIVES",
    "can_do_statement": "Can form negative imperatives of main verbs with 'don\u2019t' + main verb. \u25ba Clauses: imperatives",
    "ontology": {
      "domain": "DEONTIC_FORCE",
      "mental_model": "Prohibiting an action",
      "pedagogical_hook": "Using 'Don't' at the start of a clause to give a negative command.",
      "agency_or_distance": "Distance"
    },
    "detection": {
      "regex_triage": "(?i)(?:^|[.?!]\\s*|\\bplease\\s+)(?:do\\s+not|don't)\\s+[a-z]+",
