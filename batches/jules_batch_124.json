      "spacy_token_pattern": [
        {
          "LEMMA": {
            "IN": [
              "be",
              "have"
            ]
          },
          "TAG": {
            "IN": [
              "VBP",
              "VBZ"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "not",
              "n't"
            ]
          }
        },
        {
          "POS": "ADV",
          "OP": "?"
        },
        {
          "TAG": {
            "IN": [
              "VBG",
              "VBN"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "The window is broken and is not closing.",
        "Now, I haven't got any money."
      ],
      "negatives": [
        "I am not happy about it.",
        "He has not the time to do this."
      ]
    }
  },
