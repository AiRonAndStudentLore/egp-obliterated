[
  {
    "egp_id": "1741163716068x228640925138144930",
    "level": "A2",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
    "guideword": "FORM: PRONOUNS ",
    "can_do_statement": "Can use a limited range of determiners as pronouns and indefinite pronouns in negative contexts.  \u25ba Pronouns: quantity",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Absence of quantity or items",
      "pedagogical_hook": "Using 'any' or 'many' without a noun to refer back to something absent.",
      "agency_or_distance": "Distance"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:not|n't|don't|haven't|hasn't|didn't|isn't|aren't|wasn't|weren't)\\b.*?\\b(?:any|many|anything|anyone|anybody)\\b(?!\\s+[a-z]+)",
      "spacy_token_pattern": [
        {
          "LEMMA": {
            "IN": [
              "not",
              "n't"
            ]
          }
        },
        {
          "OP": "*"
        },
        {
          "LOWER": {
            "IN": [
              "any",
              "many",
              "anything",
              "anyone",
              "anybody"
            ]
          },
          "DEP": {
            "NOT_IN": [
              "det",
              "amod",
              "compound"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I bought a shirt, because I haven't got any.",
        "As regards close friends, I don't have many."
      ],
      "negatives": [
        "I don't have any money left.",
        "She didn't see many friends."
      ]
    }
  },
  {
    "egp_id": "1741163716068x372734050861656100",
    "level": "A2",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
