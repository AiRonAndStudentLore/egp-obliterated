[
  {
    "egp_id": "1741163708329x778951051617750700",
    "level": "A1",
    "super_category": "CLAUSES",
    "sub_category": "declarative",
    "lexical_range": "N/A",
    "guideword": "FORM: NEGATIVE DECLARATIVE WITH 'BE'",
    "can_do_statement": "Can form a simple negative declarative clause with lexical 'be' + 'not' or 'n't'. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Stating that an entity lacks a certain attribute or identity",
      "pedagogical_hook": "Negative state of being",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:am|is|are|was|were|'m|'re|'s)\\b(?:\\s+[a-z]+ly)?\\s+(?:not|n't)\\b(?!\\s+(?:going|doing|playing)\\b)|\\b(?:isn't|aren't|wasn't|weren't)\\b(?!\\s+(?:going|doing|playing)\\b)",
      "spacy_token_pattern": [
        {
          "LEMMA": "be"
        },
        {
          "LOWER": {
            "IN": [
              "not",
              "n't"
            ]
          }
        },
        {
          "LEMMA": {
            "NOT_IN": [
              "go",
              "do",
              "play",
              "eat"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "My college is not very big.",
        "This place isn't big."
      ],
      "negatives": [
        "He isn't going to the store.",
        "I haven't got any time."
      ]
    }
  },
