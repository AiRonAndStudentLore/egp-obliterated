              "by",
              "from"
            ]
          }
        },
        {
          "LOWER": {
            "REGEX": "^[a-z]+ly$"
          },
          "OP": "?"
        },
        {
          "LOWER": {
            "IN": [
              "the",
              "a",
              "an",
              "my",
              "your",
              "his",
              "her",
              "our",
              "their"
            ]
          },
          "OP": "?"
        },
        {
          "DEP": "pobj"
        }
      ]
    },
    "unit_tests": {
