              "morning",
              "evening",
              "thing",
              "nothing",
              "something",
              "everything",
              "anything",
              "building",
              "ceiling",
              "meaning",
              "spring",
              "king",
              "ring"
            ]
          },
          "DEP": {
            "IN": [
              "csubj",
              "nsubj",
              "csubjpass",
              "nsubjpass"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Working until midnight every evening is not reasonable.",
        "Driving in a city is stressful."
      ],
      "negatives": [
        "I am working until midnight every evening.",
        "The morning is nice."
      ]
    }
  },
