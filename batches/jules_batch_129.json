    "level": "B2",
    "super_category": "NOUNS",
    "sub_category": "types",
    "lexical_range": "2",
    "guideword": "FORM'-ING' FORMS, SUBJECT",
    "can_do_statement": "Can use the '-ing' form of verbs as nouns in subject position.  ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Action as Concept",
      "pedagogical_hook": "Using '-ing' verbs as the main subject of a sentence to talk about activities.",
      "agency_or_distance": "N/A"
    },
    "detection": {
      "regex_triage": "(?i)(?:^|(?<=[.?!]\\s))\\b[A-Za-z]{3,}ing\\b(?:\\s+[a-z]+){0,5}\\s+(?:is|are|was|were|has|have|will|can|could|would|should|makes|takes|demands|requires|means|causes)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "REGEX": "^[a-z]{3,}ing$"
          },
          "LEMMA": {
