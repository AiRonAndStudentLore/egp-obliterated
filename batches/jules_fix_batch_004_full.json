  }
 },
 {
  "egp_id": "1741163706533x775298022555111400",
  "level": "A2",
  "super_category": "ADJECTIVES",
  "sub_category": "superlatives",
  "guideword": "FORM/USE: WITH 'OF' + NOUN",
  "can_do_statement": "Can use a limited range of prepositional phrases with 'of' after a superlative adjective, to refer to one thing within a set or part of a set.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "'of' names the set from which the ranked member is drawn",
   "pedagogical_hook": "best of WHAT? - of names the pile",
   "agency_or_distance": "speaker picks one thing out of a stated set"
  },
  "detection": {
   "regex_triage": "\\b(?:the|this|that|my|his|her|our|their)\\s+(?!(?:test|rest|west|quest|chest|least|lest|forest|interest|contest|protest|request|digest|modest|honest|suggest|invest|divest|manifest|attest)\\b)(?:[a-z]+est|best|worst)\\s+of\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "the",
       "this",
       "that",
       "my",
       "his",
       "her",
       "our",
       "their"
      ]
     }
    },
    {
     "TAG": "JJS"
    },
    {
     "LOWER": "of"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "He is the best of us.",
    "That was the hardest of the tests."
   ],
   "negatives": [
    "It is one of the best tests.",
    "She is the best."
   ]
  }
 },
 {
  "egp_id": "1741163706533x179575258829023140",
  "level": "A2",
  "super_category": "ADJECTIVES",
  "sub_category": "superlatives",
  "guideword": "FORM/USE: COMPLEX NOUN PHRASES",
  "can_do_statement": "Can form a limited range of complex noun phrases with a superlative adjective  + prepositional phrase, to talk about something unique.\u25ba noun phrases \u25ba  clauses: comparison",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "a superlative plus a set-specifier phrase carves out the single unique member",
   "pedagogical_hook": "name the thing, then name the world it beats",
   "agency_or_distance": "speaker positions an entity as one-of-everything"
  },
  "detection": {
   "regex_triage": "\\b(?:the|my|your|his|her|our|their)\\s+(?!(?:test|rest|west|quest|chest|least|lest|forest|interest|contest|protest|request|digest|modest|honest|suggest|invest|divest|manifest|attest)\\b)(?:[a-z]+est|best|worst)\\s+(?:[a-z]+\\s+){1,4}(?:of|in)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "the",
       "my",
       "your",
       "his",
       "her",
       "our",
       "their"
      ]
     }
    },
    {
     "TAG": "JJS"
    },
    {
     "POS": {
      "IN": [
       "NOUN",
       "PROPN"
      ]
     },
     "OP": "+"
    },
    {
     "LOWER": {
      "IN": [
       "of",
       "in"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "She is the best player in the team.",
    "It is the biggest company of corn."
   ],
   "negatives": [
    "He is the best of the players.",
    "It is the best."
   ]
  }
 },
 {
