[
 {
  "egp_id": "1741163706322x848626639383521500",
  "level": "A2",
  "super_category": "ADJECTIVES",
  "sub_category": "comparatives",
  "guideword": "FORM: BEFORE NOUNS",
  "can_do_statement": "Can use comparative adjectives attributively, before nouns. ",
  "ontology": {
   "agency_or_distance": "attributive scale placement",
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "comparison glued to the noun it ranks",
   "pedagogical_hook": "the ranked noun"
  },
  "detection": {
   "regex_triage": "\\b(?:younger|older|better|bigger|taller|smaller|faster|cheaper)\\s+(?!(?:than|as|me|you|him|her|it|them|us|or|and|but|if|that|this|these|those|then|when|where|why|who|what|to|for|with|in|on|at|by|from|about|because|so|if)\\b)[a-z]+\\b",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "younger",
       "older",
       "better",
       "bigger",
       "taller",
       "smaller",
       "faster",
       "cheaper"
      ]
     },
     "DEP": "amod"
    },
    {
     "POS": {
      "IN": [
       "NOUN",
       "PROPN"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "I want a better car.",
    "She needs a bigger house."
   ],
   "negatives": [
    "It is better than the iPad.",
    "It's better that you say."
   ]
  }
 },
 {
  "egp_id": "1741163706326x982625360706106900",
  "level": "A2",
  "super_category": "ADJECTIVES",
  "sub_category": "modifying",
  "guideword": "FORM: WITH DEGREE ADVERBS",
