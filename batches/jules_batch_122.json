  {
    "egp_id": "1741163711299x956666388048580000",
    "level": "B2",
    "super_category": "MODALITY",
    "sub_category": "will",
    "lexical_range": "3",
    "guideword": "USE: REQUESTS",
    "can_do_statement": "Can use 'will' (particularly 'Will you please') to make requests and commands in a wide range of contexts.",
    "ontology": {
      "domain": "DEONTIC_FORCE",
      "mental_model": "Direct Requests",
      "pedagogical_hook": "Using 'will you' to firmly request or command",
      "agency_or_distance": "Direct and potentially forceful"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?<!when\\s)(?<!how\\s)(?<!what\\s)(?<!why\\s)(?<!where\\s)will\\s+you\\s+(?:please\\s+)?[a-z]+\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "will",
          "IS_SENT_START": true
        },
        {
          "LOWER": "you"
        },
        {
          "LOWER": "please",
          "OP": "?"
        },
        {
          "POS": {
            "IN": [
              "VERB",
              "AUX"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Will you please send me his name?",
        "Will you pay attention to the screen!"
      ],
      "negatives": [
        "When will you arrive?",
        "I think you will do it nicely."
      ]
    }
  },
