[
  {
    "egp_id": "1741163711299x337236996148793340",
    "level": "B1",
    "super_category": "MODALITY",
    "sub_category": "will",
    "lexical_range": "N/A",
    "guideword": "USE: FIXED PLANS",
    "can_do_statement": "Can use 'will' to talk about fixed plans in the future, often with timetabled times or dates.",
    "ontology": {
      "domain": "TEMPORAL_ASPECT",
      "mental_model": "Future Event Scheduling",
      "pedagogical_hook": "Using 'will' to discuss scheduled future events",
      "agency_or_distance": "High certainty regarding future timing"
    },
    "detection": {
      "regex_triage": "(?i)(?:\\b(?:will|won't)|'ll)\\s+(?:[a-z']+\\s+){0,8}(?:tomorrow|next|tonight|monday|tuesday|wednesday|thursday|friday|saturday|sunday)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "will",
              "won't",
              "'ll",
              "wo"
            ]
          }
        },
        {
          "OP": "*"
        },
        {
          "LOWER": {
            "IN": [
              "tomorrow",
              "next",
              "tonight",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I will see you tomorrow at noon.",
        "We'll arrive next Thursday morning."
      ],
      "negatives": [
        "I will definitely do it for you.",
        "He visited us next to the bank."
      ]
    }
  },
  {
