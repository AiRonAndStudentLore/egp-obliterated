  {
    "egp_id": "1741163708149x199194532751942660",
    "level": "B1",
    "super_category": "CLAUSES",
    "sub_category": "comparatives",
    "lexical_range": "N/A",
    "guideword": "FORM: FINITE AFTER 'THAN'",
    "can_do_statement": "Can use 'than' + a finite clause forming the second part of a comparison after a comparative adjective",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Comparing against a state of affairs",
      "pedagogical_hook": "Comparing reality to expectations or facts",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "\\bthan\\s+(?:i|you|he|she|it|we|they|there|everyone|anyone|someone|nobody)[a-z']*\\s+(?:am|is|are|was|were|do|does|did|can|could|will|would|have|has|had)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "than"
        },
        {
          "DEP": {
            "IN": [
              "nsubj",
              "expl"
            ]
          }
        },
        {
          "LEMMA": {
            "IN": [
              "be",
              "do",
              "have",
              "can",
              "will",
              "would",
              "could",
              "should",
              "may",
              "might",
              "must"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I wish our schools could become better than they are.",
        "The room seems to be bigger than it is really."
      ],
      "negatives": [
        "He is taller than his brother.",
        "It costs more than ten dollars."
      ]
    }
  },
  {
