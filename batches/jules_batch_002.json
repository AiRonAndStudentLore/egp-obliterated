[
  {
    "egp_id": "1741163706930x438424096883169660",
    "level": "B2",
    "super_category": "ADVERBS",
    "sub_category": "adverbs as modifiers",
    "lexical_range": "N/A",
    "guideword": "FORM: DEGREE, MODIFYING PRONOUNS",
    "can_do_statement": "Can use degree adverbs to modify pronouns. \u25ba pronouns",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Concept boundaries and set theory",
      "pedagogical_hook": "Using degree to modify completeness of sets",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "\\b(?:absolutely|almost|virtually|nearly|practically|simply|just)\\s+(?:anything|nothing|everything|something|anyone|everyone|no\\s*one|nobody|everybody|anybody)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "absolutely",
              "almost",
              "virtually",
              "nearly",
              "practically",
              "simply",
              "just"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "anything",
              "nothing",
              "everything",
              "something",
              "anyone",
              "everyone",
              "nobody",
              "everybody",
              "anybody"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "You can buy absolutely anything you like.",
        "She said almost nothing during the meeting."
      ],
      "negatives": [
        "The dog is absolutely adorable.",
        "Almost all the people left early."
      ]
    }
  },
  {
