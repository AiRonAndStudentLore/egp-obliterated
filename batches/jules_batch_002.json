    "level": "B1",
    "super_category": "CLAUSES",
    "sub_category": "comparatives",
    "lexical_range": "1",
    "guideword": "FORM/USE: NON-FINITE AFTER 'THAN'",
    "can_do_statement": "Can use 'than' + a limited range of non-finite clauses (with -ing), forming the second part of a comparison after a comparative adjective",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Action comparison",
      "pedagogical_hook": "Comparing two activities directly",
      "agency_or_distance": "agency"
    },
    "detection": {
      "regex_triage": "\\bthan\\s+[a-z]+ing\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "than"
        },
        {
          "TAG": {
            "IN": [
              "VBG",
              "NN"
            ]
          },
          "LOWER": {
            "REGEX": ".*ing$"
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "It's less complicated than going to a large school in a town.",
        "It will be more fun than sitting at home."
