        {
          "LOWER": "rather"
        },
        {
          "LOWER": "than"
        },
        {
          "LOWER": {
            "NOT_IN": [
              "going",
              "doing",
              "seeing",
              "being",
              "having"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Use the stairs rather than the lift.",
        "Eat healthy foods rather than fatty foods."
      ],
      "negatives": [
        "I would rather go home than stay here.",
        "He decided to resign rather than face dismissal."
      ]
    }
  },
  {
