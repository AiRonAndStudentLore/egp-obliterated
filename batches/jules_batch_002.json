      "negatives": [
        "I have more money than the king.",
        "He ran faster than he ever had before."
      ]
    }
  },
  {
    "egp_id": "1741163708149x584991035733899400",
    "level": "B1",
    "super_category": "CLAUSES",
    "sub_category": "comparatives",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: 'RATHER THAN' + PHRASE",
    "can_do_statement": "Can use 'rather than' + noun phrase or prepositional phrase to stress one element in a comparison. ",
