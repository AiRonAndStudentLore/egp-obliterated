      "spacy_token_pattern": [
        {
          "LOWER": "as"
        },
        {
          "OP": "?"
        },
        {
          "LOWER": "as"
        },
        {
          "DEP": "nsubj"
        },
        {
          "LEMMA": {
            "IN": [
              "can",
              "could",
              "do",
              "be",
              "have",
              "expect",
              "remember",
              "like",
              "want"
            ]
          }
        }
      ]
    },
    "unit_tests": {
