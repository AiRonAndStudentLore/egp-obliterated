    "guideword": "USE: RECENT PAST",
    "can_do_statement": "Can use the present perfect simple to refer to a finished event or state in the recent past, that has a present relevance, often with 'just'.  ► adverbs",
    "ontology": {
      "domain": "TEMPORAL_ASPECT",
      "mental_model": "Past events that have just finished with present relevance.",
      "pedagogical_hook": "When talking about something that happened very recently, use 'have/has just' plus the past participle.",
      "agency_or_distance": "N/A"
    },
    "detection": {
