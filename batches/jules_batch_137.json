          "LEMMA": "have"
        },
        {
          "LOWER": "just"
        },
        {
          "TAG": "VBN"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I've just received your mail.",
        "My mother has just broken her right leg."
      ],
      "negatives": [
        "I just received your mail.",
        "I'm just going to the shop."
      ]
