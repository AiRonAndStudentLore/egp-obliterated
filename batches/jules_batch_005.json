      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "and",
              "not"
            ]
          },
          "IS_SENT_START": true
        },
        {
          "LOWER": "not",
          "OP": "?"
        },
        {
          "LOWER": "only"
        },
        {
          "LEMMA": {
            "IN": [
              "do",
              "be",
              "have",
              "can",
              "could",
              "will",
              "would",
              "shall",
              "should",
              "may",
              "might"
            ]
          }
        },
        {
          "OP": "*"
        },
        {
          "LOWER": "but"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Not only did they come, but many others attended.",
        "And not only was he helpful but the students learned a lot."
      ],
      "negatives": [
        "He not only studies hard, but also plays well.",
        "I only wanted to help."
      ]
    }
  },
