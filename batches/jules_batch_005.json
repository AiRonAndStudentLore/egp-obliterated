          "IS_SENT_START": true,
          "LOWER": "if"
        },
        {
          "LOWER": "it"
        },
        {
          "LOWER": "were"
        },
        {
          "LOWER": "n't",
          "OP": "?"
        },
        {
          "LOWER": "not",
          "OP": "?"
        },
        {
          "LOWER": "for"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "If it weren't for that boy, I would have failed.",
        "If it were not for his determination, he would have resigned."
      ],
      "negatives": [
        "I wonder if it were not meant to be.",
        "They asked if it were not for me, but for him."
      ]
    }
  },
