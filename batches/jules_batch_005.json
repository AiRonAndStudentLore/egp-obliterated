          "LOWER": "should"
        },
        {
          "POS": {
            "IN": [
              "PRON",
              "NOUN",
              "PROPN",
              "DET"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Should you require any further information, please ask.",
        "Should there be a lack of mutual understanding a break-up is unavoidable."
