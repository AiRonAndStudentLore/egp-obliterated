    "super_category": "CLAUSES",
    "sub_category": "conditional",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: 'IF IT WERE NOT FOR', FORMAL",
    "can_do_statement": "Can use 'If it weren\u2019t / were not for' + noun phrase to introduce conditions in formal contexts. \u25ba past simple",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
