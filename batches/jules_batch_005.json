    "guideword": "FORM: INVERTED CONDITIONAL CLAUSE, 'SHOULD'",
    "can_do_statement": "Can introduce a conditional subordinate clause with 'should' + inverted subject.",
    "ontology": {
      "domain": "DEONTIC_FORCE",
      "mental_model": "Hypothetical condition introduced by modal inversion",
      "pedagogical_hook": "Using 'should' to mean 'if' in formal contexts",
      "agency_or_distance": "High distance, formal"
