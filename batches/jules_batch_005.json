              "then",
              "so"
            ]
          }
        },
        {
          "OP": "+"
        },
        {
          "IS_PUNCT": true,
          "OP": "?"
        },
        {
          "LOWER": {
            "IN": [
              "and",
              "then",
              "so"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Go straight ahead, then turn right, and walk to the end.",
