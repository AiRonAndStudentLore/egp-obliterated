    "guideword": "FORM/USE: 'NOT ONLY \u2026 BUT (ALSO)', FOCUS",
    "can_do_statement": "Can combine clauses using 'not only' in mid position of the first clause followed by \u2026 'but (also)' to introduce the second clause, to give focus.",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Adding emphasis to a second point",
      "pedagogical_hook": "Emphasizing two related points",
      "agency_or_distance": "Neutral"
    },
    "detection": {
      "regex_triage": "(?i)(?<!^)(?<!^\\s)\\bnot\\s+only\\b.*?\\bbut\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "not",
          "IS_SENT_START": false
        },
        {
          "LOWER": "only"
        },
        {
          "OP": "*"
        },
        {
          "LOWER": "but"
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "It is nice not only because it is colorful, but because I like it.",
        "He not only studies hard, but also plays well."
      ],
      "negatives": [
