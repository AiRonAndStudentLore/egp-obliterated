      "IN": [
       "all",
       "both"
      ]
     }
    },
    {
     "LOWER": "of"
    },
    {
     "LOWER": {
      "IN": [
       "us",
       "them",
       "you",
       "it",
       "him",
       "her"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
