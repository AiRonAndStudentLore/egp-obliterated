  "guideword": "FORM: WITH 'OF' + OBJECT PRONOUN",
  "can_do_statement": "Can use a limited range of pronouns ('all', 'both') with 'of' followed by an object pronoun, to refer to quantity.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "quantity allocation",
   "pedagogical_hook": "referring to the entirety or duality of a specific group using 'all/both of'",
   "agency_or_distance": "N/A"
  },
  "detection": {
   "regex_triage": "\\b(?:all|both)\\s+of\\s+(?:us|them|you|it|him|her)\\b",
   "spacy_token_pattern": [
