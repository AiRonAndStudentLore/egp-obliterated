  "lexical_range": "N/A",
  "guideword": "FORM: QUESTIONS WITH 'LIKE'",
  "can_do_statement": "Can use the question form 'would you like'.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "Expressing desires or offers formally.",
   "pedagogical_hook": "Using 'would you like' to offer or invite.",
   "agency_or_distance": "Distal/Polite"
  },
  "detection": {
