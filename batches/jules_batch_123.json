   "spacy_token_pattern": [
    {
     "LOWER": "would"
    },
    {
     "LOWER": "you"
    },
    {
     "OP": "?",
     "LOWER": {
      "REGEX": "^[a-z]+ly$"
     }
    },
    {
     "LOWER": "like"
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Would you like to play tennis?",
    "I'm going to a concert, would you like to come?"
   ],
   "negatives": [
    "Do you like tennis?",
    "I would like some water."
   ]
  }
