 {
  "egp_id": "1741163711528x898984751471889600",
  "level": "B1",
  "super_category": "MODALITY",
  "sub_category": "would",
  "lexical_range": "N/A",
  "guideword": "FORM/USE: AFTER 'IF' CLAUSES",
  "can_do_statement": "Can use 'would' in the main clause of a conditional sentence to talk about an imagined situation, often in the context of advice or opinion-giving.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "Speculating about imagined scenarios, especially for advice.",
   "pedagogical_hook": "Using 'would' in conditional main clauses to give advice.",
   "agency_or_distance": "Hypothetical"
  },
  "detection": {
   "regex_triage": "(?i)\\bif\\b\\s+(?:I\\s+were|I\\s+had|you\\s+decided|you\\s+want|we\\s+went|he\\s+was|she\\s+was)[^.?!]{1,40}\\b(?:would|'d)\\b",
   "spacy_token_pattern": [
    {
     "LOWER": "if"
    },
    {
     "OP": "*"
    },
    {
     "LOWER": {
      "IN": [
       "would",
       "'d"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "If I were you, I would not watch TV all the time.",
    "If I had the chance, I'd go with my friends."
   ],
   "negatives": [
    "I would like a cup of tea.",
    "She said she would arrive late."
   ]
  }
 },
