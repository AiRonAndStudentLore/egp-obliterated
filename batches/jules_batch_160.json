        "The wood on the table is very hard."
      ]
    }
  },
  {
    "egp_id": "1741163706722x916354910575195800",
    "level": "A2",
    "super_category": "ADVERBS",
    "sub_category": "adverbs and adverb phrases: types and meanings",
    "lexical_range": "2",
    "guideword": "USE: FREQUENCY ",
    "can_do_statement": "Can use an increasing range of adverbs ('usually', 'often', 'never', 'weekly') to talk about frequency.",
    "ontology": {
      "domain": "TEMPORAL_ASPECT",
      "mental_model": "frequency",
      "pedagogical_hook": "frequency adverbs",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:usually|often|never|always|sometimes|rarely|normally)\\s+(?:[a-z]+\\b)|(?:weekly|monthly)(?!\\s+(?:magazine|payment|newspaper|meeting))",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "usually",
              "often",
              "never",
              "weekly",
              "monthly",
              "always",
              "sometimes",
              "rarely",
              "normally"
            ]
          },
          "DEP": {
            "NOT_IN": [
              "amod",
              "compound",
              "pobj"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I usually wake up at seven o'clock.",
        "She often visits her grandmother on Sundays."
      ],
      "negatives": [
