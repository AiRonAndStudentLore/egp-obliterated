        "He is my greatest friend."
      ]
    }
  },
  {
    "egp_id": "1741163706722x801643981135109000",
    "level": "A2",
    "super_category": "ADVERBS",
    "sub_category": "adverbs and adverb phrases: types and meanings",
    "lexical_range": "1",
    "guideword": "USE: MANNER",
    "can_do_statement": "Can use a limited range of manner adverbs and adverb phrases to modify how something happens.",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "manner",
      "pedagogical_hook": "manner adverbs",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:play|plays|played|go|goes|went|run|runs|ran|swim|swims|swam|work|works|worked|speak|speaks|spoke|do|does|did|eat|eats|ate|walk|walks|walked|talk|talks|talked|drive|drives|drove)\\s+(?:(?:[a-z]+\\s+){0,3})?(?:well|fast|quickly|slowly|hard|badly|loudly|quietly|carefully)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "well",
              "fast",
              "quickly",
              "slowly",
              "hard",
              "badly",
              "loudly",
              "quietly",
              "carefully"
            ]
          },
          "DEP": "advmod"
        }
      ]
    },
    "unit_tests": {
      "positives": [
