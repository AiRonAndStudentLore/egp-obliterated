[
  {
    "egp_id": "1741163706530x116599041764892110",
    "level": "A2",
    "super_category": "ADJECTIVES",
    "sub_category": "position",
    "lexical_range": "1",
    "guideword": "FORM/USE: LIMITING ADJECTIVES",
    "can_do_statement": "Can use a limited range of adjectives ('main', 'only') that limit the noun that they go before.",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "specification",
      "pedagogical_hook": "limiting adjectives",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:the|my|your|his|her|its|our|their|a|an)\\s+(?:main|only)\\s+[a-z]+",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "main",
              "only"
            ]
          },
          "DEP": "amod"
        },
        {
          "POS": {
            "IN": [
              "NOUN",
              "PROPN"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "This is the main reason I came here.",
        "He was the only person who understood."
      ],
      "negatives": [
        "I only want to sleep for a bit.",
        "The water main broke yesterday."
      ]
    }
  },
  {
    "egp_id": "1741163706534x741393105415276700",
    "level": "A2",
    "super_category": "ADJECTIVES",
    "sub_category": "superlatives",
    "lexical_range": "N/A",
