      "spacy_token_pattern": [
        {
          "POS": "VERB"
        },
        {
          "OP": "*",
          "POS": "ADP"
        },
        {
          "OP": "*",
          "POS": "PRON"
        },
        {
          "POS": "ADV",
          "LOWER": {
            "REGEX": "ly$"
          }
        }
      ]
    },
