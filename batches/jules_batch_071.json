[
  {
    "egp_id": "1741163706534x938846205163626000",
    "level": "A2",
    "super_category": "ADJECTIVES",
    "sub_category": "superlatives",
    "lexical_range": "1",
    "guideword": "FORM: ELLIPSIS, WITH 'THE'",
    "can_do_statement": "Can use 'the' with a limited range of superlative adjectives without a following noun, when the noun is understood.",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Identifying the extreme point on a scale without explicitly naming the entity",
      "pedagogical_hook": "When you already know what we're talking about, just say 'the best' instead of 'the best thing'.",
      "agency_or_distance": "High conceptual distance (referencing an abstract peak)."
    },
    "detection": {
      "regex_triage": "(?i)\\bthe\\s+(?:best|worst|most\\s+[a-z]+|[a-z]+est)(?:\\s*[,.!?;:]|\\s+(?:is|was|are|were|has|have|did|does|can|could|would|should|will|shall|might|must|may)\\b|\\s*$)",
      "spacy_token_pattern": [
        {
          "LOWER": "the"
        },
        {
          "LOWER": "most",
          "OP": "?"
        },
        {
          "TAG": {
            "IN": [
              "JJS",
              "RBS",
              "JJ"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              ".",
              "!"
            ]
          },
          "IS_PUNCT": true
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "My relatives gave me presents but the computer game was the best.",
        "But Mark's present was the most beautiful!"
      ],
      "negatives": [
        "It is the best book I have ever read.",
        "That is the most beautiful car."
      ]
    }
  },
  {
