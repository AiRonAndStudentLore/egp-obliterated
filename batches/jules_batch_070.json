[
  {
    "egp_id": "1741163715274x912538940118367500",
    "level": "B1",
    "super_category": "VERBS",
    "sub_category": "phrasal-prepositional",
    "lexical_range": "1",
    "guideword": "FORM: VERB + PARTICLE + PREPOSITION + OBJECT",
    "can_do_statement": "Can use a limited range of verbs + particle + preposition + noun or pronoun. ",
    "ontology": {
      "domain": "ENTITY_TOPOLOGY",
      "mental_model": "Spatial action chains mapping abstract state transitions",
      "pedagogical_hook": "Think of the particle and preposition as directions the action takes.",
      "agency_or_distance": "agency"
    },
    "detection": {
      "regex_triage": "(?i)\\b(?:catch|get|keep|look|put|come)\\b(?:\\s+[a-z]+ly)?\\s+(?:up|on|away|out)\\s+(?:with|from|for|to)\\b",
      "spacy_token_pattern": [
        {
          "LEMMA": {
            "IN": [
              "catch",
              "get",
              "keep",
              "look",
              "put",
              "come"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "up",
              "on",
              "away",
              "out"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "with",
              "from",
              "for",
              "to"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "I could catch up with the work I missed after school.",
        "They get on with each other very well."
      ],
      "negatives": [
        "I catch a ball when it is thrown.",
        "Look at the big tree."
      ]
    }
  },
  {
    "egp_id": "1741163715275x268506157109972930",
    "level": "C1",
    "super_category": "VERBS",
    "sub_category": "phrasal-prepositional",
    "lexical_range": "N/A",
