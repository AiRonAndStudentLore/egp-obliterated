              "could",
              "shall",
              "should",
              "may",
              "might",
              "must"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "not",
              "n't"
            ]
          },
          "OP": "?"
        },
        {
          "LEMMA": "be"
        }
      ]
    },
    "unit_tests": {
