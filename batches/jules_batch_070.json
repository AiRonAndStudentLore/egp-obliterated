        {
          "LEMMA": {
            "IN": [
              "come",
              "look",
              "put",
              "catch",
              "get"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "up",
              "out",
              "on",
              "away"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "with",
              "to",
              "for",
              "from"
            ]
          }
        },
        {
          "IS_PUNCT": true
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Anyway, let me tell you what ideas I came up with.",
        "This is something you will have to look out for."
      ],
      "negatives": [
        "I came up with a great idea yesterday.",
        "I look out for him every day."
      ]
    }
  },
