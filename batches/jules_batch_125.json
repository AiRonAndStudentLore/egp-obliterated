  {
    "egp_id": "1741163716072x190757617985932480",
    "level": "C1",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
    "guideword": "FORM/USE: 'NOT ONLY \u2026 (BUT) ALSO' WITH INVERSION",
    "can_do_statement": "Can use auxiliary 'do' + inverted subject after 'not only', to give focus.",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Dual assertion with structural inversion",
      "pedagogical_hook": "Inverting subject and do/does/did after not only",
      "agency_or_distance": "agency"
    },
    "detection": {
      "regex_triage": "(?i)(?:^|(?<=[.!?]\\s))not\\s+only\\s+(?:do|does|did)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": "not",
          "IS_SENT_START": true
        },
        {
          "LOWER": "only"
        },
        {
          "LOWER": {
            "IN": [
              "do",
              "does",
              "did"
            ]
          }
        },
        {
          "POS": {
            "IN": [
              "PRON",
              "NOUN",
              "PROPN"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Not only do they have the biggest turnover, they also increased it.",
        "Not only did we lose the match, but we also lost our best player."
      ],
      "negatives": [
        "We not only do our homework, but we also study.",
        "They not only did the work, but they also checked it."
      ]
    }
  },
  {
