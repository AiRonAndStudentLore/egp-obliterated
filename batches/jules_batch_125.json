[
  {
    "egp_id": "1741163716070x944796112360125800",
    "level": "B1",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
    "guideword": "FORM: ADVERBS",
    "can_do_statement": "Can use adverbs 'ever', 'never', 'yet', 'still' in negative contexts.",
    "ontology": {
      "domain": "EPISTEMIC_STANCE",
      "mental_model": "Modification of negative scope",
      "pedagogical_hook": "Using time adverbs to reinforce negation",
      "agency_or_distance": "distance"
    },
    "detection": {
      "regex_triage": "(?i)\\bnever\\b|(?:not|n't|\\bnobody\\b|\\bnothing\\b).*?\\b(?:ever|yet)\\b",
      "spacy_token_pattern": [
        {
          "LOWER": {
            "IN": [
              "nobody",
              "not",
              "n't"
            ]
          }
        },
        {
          "OP": "*",
          "LOWER": {
            "NOT_IN": [
              ".",
              "?",
              "!"
            ]
          }
        },
        {
          "LOWER": {
            "IN": [
              "ever",
              "yet"
            ]
          }
        }
      ]
    },
    "unit_tests": {
      "positives": [
        "Nobody will ever know who that man was.",
        "I haven't decided yet."
      ],
      "negatives": [
        "I have ever been there.",
        "Are you still coming to the party?"
      ]
    }
  },
  {
    "egp_id": "1741163716072x182229027169600770",
    "level": "C1",
    "super_category": "NEGATION",
    "sub_category": "negation",
    "lexical_range": "N/A",
