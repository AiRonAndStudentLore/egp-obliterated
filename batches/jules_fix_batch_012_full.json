 },
 {
  "egp_id": "1741163706726x546695627596920800",
  "level": "C1",
  "super_category": "ADVERBS",
  "sub_category": "adverbs and adverb phrases: types and meanings",
  "guideword": "USE: STANCE",
  "can_do_statement": "Can use a wide range of stance adverbs (simply, truly, surely, apparently, naturally, surprisingly, inevitably, literally, exceptionally, frankly, clearly, amazingly, wisely, admittedly) to indicate an attitude or viewpoint, often in clause initial position.",
  "ontology": {
   "domain": "EPISTEMIC_STANCE",
   "mental_model": "REFINED_STANCE",
   "pedagogical_hook": "simply / truly / surely / apparently / naturally / surprisingly / inevitably \u2014 finer-grained stance markers",
   "agency_or_distance": "speaker marks nuanced distance from the proposition"
  },
  "detection": {
   "regex_triage": "^(?:[A-Z][a-z]+,\\s+)?(?:Simply|Truly|Surely|Apparently|Naturally|Surprisingly|Inevitably|Undoubtedly|Admittedly|Evidently|Presumably|Reportedly|Obviously|Undoubtably),\\s+",
   "spacy_token_pattern": [
    {
     "LOWER": {
      "IN": [
       "simply",
       "truly",
       "surely",
       "apparently",
       "naturally",
       "surprisingly",
       "inevitably",
       "undoubtedly",
       "admittedly",
       "evidently",
       "presumably",
       "reportedly",
       "obviously",
       "undoubtably"
      ]
     },
     "IS_SENT_START": true
    },
    {
     "ORTH": ","
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "Obviously, if we produce more, we can sell more.",
    "Surprisingly, the weather was quite nice today."
   ],
   "negatives": [
    "And obviously it needs a lot of people.",
    "The answer is obviously incorrect."
   ]
  }
 },
