  "guideword": "FORM/USE: WITH 'A LOT' ",
  "can_do_statement": "Can use 'a lot' to modify and intensify comparative adjectives used predicatively after a verb, usually 'be'. ",
  "ontology": {
   "agency_or_distance": "large scale gap",
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "a lot blows the distance wide open",
   "pedagogical_hook": "blow the gap open"
  },
  "detection": {
   "regex_triage": "(?i)\\b(?:am|is|are|was|were|been|look|looks|looked|seem|seems|seemed)\\s+(?:[a-z]+\\s+)*a\\s+lot\\s+(?:(?:more|less)\\s+)?[a-z]+(?:er|est|orse|etter)\\b",
   "spacy_token_pattern": [
    {
     "POS": {
      "IN": [
       "VERB",
       "AUX"
      ]
     }
    },
    {
     "POS": "ADV",
     "OP": "*"
    },
    {
     "LOWER": "a"
    },
    {
     "LOWER": "lot"
    },
    {
     "LOWER": {
      "IN": [
       "more",
       "less"
      ]
     },
     "OP": "?"
    },
    {
     "TAG": {
      "IN": [
       "JJR",
       "RBR"
      ]
     }
    }
   ]
  },
  "unit_tests": {
   "positives": [
    "The new design looks a lot better than the old one.",
    "It is a lot cheaper to buy it online."
   ],
   "negatives": [
    "Yeah, a lot better.",
    "A lot more people are here."
   ]
  }
 },
