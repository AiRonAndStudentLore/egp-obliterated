    { "LOWER": { "IN": ["shown", "seen", "discussed", "introduced", "written", "chosen", "required", "considered", "accepted", "approved", "published", "received", "recorded", "presented", "suggested", "supported", "broken", "completed", "covered", "created", "developed", "selected", "reviewed", "addressed", "adopted", "classified", "confirmed", "defined", "derived", "divided", "illustrated", "implemented", "observed", "organized", "produced", "protected", "related", "replaced", "reserved", "separated"] } }
