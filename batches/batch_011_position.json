[
 {
  "egp_id": "1741163706530x479020650602328450",
  "level": "A1",
  "super_category": "ADJECTIVES",
  "sub_category": "position",
  "guideword": "FORM: ATTRIBUTIVE (WITH NOUNS)",
  "can_do_statement": "Can use a limited range of adjectives attributively, before a noun.",
  "ontology": {
   "domain": "ENTITY_TOPOLOGY",
   "mental_model": "ATTRIBUTIVE_PLACEMENT",
   "pedagogical_hook": "determiner + adjective + noun — slot the adjective before its noun as a foreground modifier",
   "agency_or_distance": "speaker foregrounds a property directly on the entity"
  },
  "detection": {
   "regex_triage": "(?:\\b(?:a|an|the|my|your|his|her|our|their|this|that|these|those|some|any)\\s+)(?:big|small|new|old|good|bad|nice|beautiful|happy|sad|hot|cold|red|blue|green|black|white|pretty|ugly|tall|short|long|little|young|important|interesting|expensive|cheap|nice|hard|easy|difficult|long)\\s+[a-z]+\\b",
   "spacy_token_pattern": [
    { "LOWER": { "IN": ["a", "an", "the", "my", "your", "his", "her", "our", "their", "this", "that", "these", "those", "some", "any"] } },
    { "LOWER": { "IN": ["big", "small", "new", "old", "good", "bad", "nice", "beautiful", "happy", "sad", "hot", "cold", "red", "blue", "green", "black", "white", "pretty", "ugly", "tall", "short", "long", "little", "young", "important", "interesting", "expensive", "cheap", "hard", "easy", "difficult"] } },
    { "LOWER": { "IN": ["house", "houses", "car", "cars", "room", "rooms", "book", "books", "dog", "dogs", "cat", "cats", "garden", "pool", "swimming", "friend", "friends", "neighbour", "kitchen", "table", "chair", "door", "window", "wall", "floor", "name", "home", "school", "city", "film", "films", "movie", "movies", "story", "tree", "trees"] } }
   ]
  },
  "unit_tests": {
   "positives": [
    "We have a big garden and a small swimming pool.",
    "My name is Bogdan. I am your new neighbour."
   ],
   "negatives": [
    "I went to the cinema yesterday.",
    "She left her book here."
   ]
  }
 },
 {
  "egp_id": "1741163706532x433078299562880800",
